# Copy this file to .env and paste your key in.
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys
# This is the ONLY credential the council needs — web search runs server-side
# on Anthropic's infrastructure, so there is no separate search provider.
ANTHROPIC_API_KEY=

# Optional. The character turns run on this model.
# COUNCIL_MODEL=claude-opus-5

# Optional. The token-heavy web search / fetch turns run on this one.
# COUNCIL_RESEARCH_MODEL=claude-sonnet-5
